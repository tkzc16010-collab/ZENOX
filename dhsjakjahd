----------------------------------------------------------------
-- Control registry (for config save/load + hotkeys)
----------------------------------------------------------------
local Reg, Cfg = {}, {}

local function Tog(tab, key, o, nosave)
    local cb = o.Callback
    o.Callback = function(v)
        Cfg[key] = v
        if cb then cb(v) end
    end
    o.Default = o.Default or false
    local el = tab:Toggle(o)
    Reg[key] = {el = el, nosave = nosave}
    Cfg[key] = o.Default
    return el
end

local function Sld(tab, key, o)
    local cb = o.Callback
    o.Callback = function(v)
        Cfg[key] = v
        if cb then cb(v) end
    end
    local el = tab:Slider(o)
    Reg[key] = {el = el}
    Cfg[key] = o.Value.Default
    return el
end

local function flip(key)
    local r = Reg[key]
    if r then pcall(function() r.el:Set(not Cfg[key]) end) end
end

