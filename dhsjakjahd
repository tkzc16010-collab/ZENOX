    Tog(TabTroll, "blink", {
        Title = "Blink", Desc = "กระพริบวาร์ปสั้นๆ รอบตัว",
        Callback = function(v) T.blink = v end,
    }, true)
    Sld(TabTroll, "blinkInt", {
        Title = "Blink Interval (x10ms)", Value = {Min = 10, Max = 100, Default = 35}, Step = 5,
        Callback = function(v) T.blinkInt = v / 100 end,
    })
    Tog(TabTroll, "emoteLoop", {
        Title = "Dance Loop", Desc = "เล่นท่าเต้นวนซ้ำ (เฉพาะเกมที่รองรับ Emote)",
        Callback = function(v) T.emote = v end,
