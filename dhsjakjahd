        Callback = function(v) T.speed = v end,
    })

    TabTroll:Section({Title = "Self Effects"})
    Tog(TabTroll, "fakeLag", {
        Title = "Fake Lag", Desc = "ทำให้คนอื่นเห็นเราสะดุดเหมือนแลค",
