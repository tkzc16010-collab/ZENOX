do
    Store.macros = Store.macros or {}

    local function r2(x) return math.floor(x * 100 + 0.5) / 100 end
    local function r3(x) return math.floor(x * 1000 + 0.5) / 1000 end

    ----------------------------------------------------------------
    -- TROLL
    ----------------------------------------------------------------
    local T = {
        mode = "Orbit", target = false, radius = 8, speed = 3, angle = 0,
        lag = false, jitter = false, jitAmt = 25,
        blink = false, blinkInt = 0.35,
        emote = false, dizzy = false, dizAmt = 8,
    }
    local blinkAcc, blinkOrig = 0, nil
    local trollConn

    local function cleanupTroll()
        if trollConn then trollConn:Disconnect() trollConn = nil end
        T.lag, T.target = false, false
        pcall(function() RunService:UnbindFromRenderStep("ZenoxDizzy") end)
        local r = getRoot()
        if r then r.Anchored = false end
    end

    trollConn = RunService.Heartbeat:Connect(function(dt)
        if not ENV.ZENOX_LOADED then cleanupTroll() return end
        local root, hum = getRoot(), getHum()
        if not root then return end

        if T.target then
            local tChar = selectedPlayer and selectedPlayer.Character
            local tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")
            if tRoot then
                if T.mode == "Orbit" then
                    T.angle += T.speed * dt
                    local off = Vector3.new(math.cos(T.angle) * T.radius, 0, math.sin(T.angle) * T.radius)
                    root.CFrame = CFrame.lookAt(tRoot.Position + off, tRoot.Position)
                elseif T.mode == "Follow" then
                    root.CFrame = tRoot.CFrame * CFrame.new(0, 0, T.radius)
                elseif T.mode == "Headsit" then
                    local head = tChar:FindFirstChild("Head")
                    if head then root.CFrame = head.CFrame * CFrame.new(0, 1.6, 0) end
                    if hum then hum.Sit = true end
                    root.AssemblyLinearVelocity = Vector3.zero
                elseif T.mode == "Piggyback" then
                    root.CFrame = tRoot.CFrame * CFrame.new(0, 0.5, 0.9)
                    if hum then hum.Sit = true end
                    root.AssemblyLinearVelocity = Vector3.zero
                end
            end
        end

        if T.jitter then
            root.CFrame = root.CFrame * CFrame.Angles(0, math.rad(math.random(-T.jitAmt, T.jitAmt)), 0)
        end

        if T.blink then
            blinkAcc += dt
            if blinkOrig then
                root.CFrame = blinkOrig
                blinkOrig = nil
            elseif blinkAcc >= T.blinkInt then
                blinkAcc = 0
                blinkOrig = root.CFrame
                local a = math.random() * math.pi * 2
                root.CFrame = blinkOrig + Vector3.new(math.cos(a) * 4, 0, math.sin(a) * 4)
            end
        else
            blinkOrig = nil
        end
    end)

    -- Fake lag
    task.spawn(function()
        while ENV.ZENOX_LOADED do
            task.wait(0.25)
            if T.lag then
                local r = getRoot()
                if r then
                    r.Anchored = true
                    task.wait(0.12)
                    r.Anchored = false
                end
            end
        end
    end)

    -- Emote loop
    task.spawn(function()
        local list = {"dance", "dance2", "dance3"}
        while ENV.ZENOX_LOADED do
            task.wait(2.5)
            if T.emote then
                local h = getHum()
                if h then pcall(function() h:PlayEmote(list[math.random(1, #list)]) end) end
            end
        end
    end)

    -- Dizzy screen (เห็นแค่ฝั่งเรา)
    local function setDizzy(on)
        pcall(function() RunService:UnbindFromRenderStep("ZenoxDizzy") end)
        if on then
            RunService:BindToRenderStep("ZenoxDizzy", Enum.RenderPriority.Camera.Value + 1, function()
                if not ENV.ZENOX_LOADED then
                    pcall(function() RunService:UnbindFromRenderStep("ZenoxDizzy") end)
                    return
                end
                local c = cam()
                c.CFrame = c.CFrame * CFrame.Angles(0, 0, math.sin(os.clock() * 2) * math.rad(T.dizAmt))
            end)
        end
    end

    ---------------- TROLL UI ----------------
    TabTroll:Section({Title = "Target Player"})
    TabTroll:Paragraph({
        Title = "> วิธีใช้",
        Desc = "เลือกผู้เล่นที่แท็บ Teleport > Select Player ก่อน แล้วกลับมาเปิดโหมดที่นี่",
    })
    TabTroll:Dropdown({
        Title = "Mode", Values = {"Orbit", "Follow", "Headsit", "Piggyback"}, Value = "Orbit",
