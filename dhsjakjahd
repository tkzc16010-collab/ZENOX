        Callback = function(v) T.dizAmt = v end,
    })

    ----------------------------------------------------------------
    -- MACRO (บันทึกเส้นทาง + ปุ่มที่กด แล้วเล่นซ้ำ)
    ----------------------------------------------------------------
    local M = {name = "", interval = 0.1, speed = 1, loop = false, selected = nil, importText = ""}
    local Rec = {on = false, t0 = 0, last = 0, path = {}, events = {}, conns = {}}
    local Play = {conn = nil, t = 0, dur = 0, name = ""}

    -- คีย์ที่ไม่บันทึก (เดินใช้เส้นทางแทน + คีย์ลัดของฮับ)
    local SKIP = {}
    for _, k in ipairs({"W", "A", "S", "D", "Space", "Unknown", "Q", "LeftShift", "RightShift",
        "LeftControl", "RightControl", "LeftAlt", "RightAlt",
        "F", "N", "X", "K", "L", "P", "J", "C", "G", "H", "B", "M"}) do SKIP[k] = true end

    local function macroNames()
        local t = {}
        for n in pairs(Store.macros) do table.insert(t, n) end
        table.sort(t)
        if #t == 0 then t = {"(empty)"} end
        return t
    end

    local macroDD
    local function refreshMacros() pcall(function() macroDD:Refresh(macroNames()) end) end

    local function pressKeyName(n)
        local ok, kc = pcall(function() return Enum.KeyCode[n] end)
        if VIM and ok and kc then
            pcall(function()
                VIM:SendKeyEvent(true, kc, false, game)
                task.wait(0.05)
                VIM:SendKeyEvent(false, kc, false, game)
            end)
        end
    end

    -- ---- record ----
    local function sample()
        local root = getRoot()
        if not root then return end
        local p = root.Position
        local _, yaw = root.CFrame:ToOrientation()
        table.insert(Rec.path, {r3(os.clock() - Rec.t0), r2(p.X), r2(p.Y), r2(p.Z), r3(yaw)})
    end

    local function stopPlay()
        if Play.conn then Play.conn:Disconnect() Play.conn = nil end
    end

    local function stopRecording(save)
        Rec.on = false
        for _, c in ipairs(Rec.conns) do c:Disconnect() end
        Rec.conns = {}
        if not save then return end
        sample()
        if #Rec.path < 2 then notify("Macro", "สั้นเกินไป ไม่ได้บันทึก", "x") return end
        local count = 0
        for _ in pairs(Store.macros) do count += 1 end
        local name = (M.name ~= "" and M.name) or ("Macro" .. (count + 1))
        Store.macros[name] = {path = Rec.path, events = Rec.events, dur = Rec.path[#Rec.path][1]}
        saveStore()
        refreshMacros()
        notify("Macro", "บันทึก: " .. name, "check")
    end

    local function startRecording()
        stopPlay()
        Rec.path, Rec.events = {}, {}
        Rec.t0, Rec.last, Rec.on = os.clock(), 0, true
        sample()
        table.insert(Rec.conns, RunService.Heartbeat:Connect(function()
            if not ENV.ZENOX_LOADED then stopRecording(false) return end
            local now = os.clock() - Rec.t0
            if now - Rec.last >= M.interval then Rec.last = now sample() end
            if #Rec.path >= 6000 then
                stopRecording(true)
                if Cfg.macroRec then flip("macroRec") end
            end
        end))
        table.insert(Rec.conns, UIS.InputBegan:Connect(function(input, gp)
            if gp or input.UserInputType ~= Enum.UserInputType.Keyboard then return end
            local n = input.KeyCode.Name
            if SKIP[n] then return end
            table.insert(Rec.events, {r3(os.clock() - Rec.t0), "k", n})
        end))
        table.insert(Rec.conns, UIS.JumpRequest:Connect(function()
            table.insert(Rec.events, {r3(os.clock() - Rec.t0), "j"})
        end))
    end

    -- ---- play ----
    local function startPlay(name)
        local m = Store.macros[name]
        if not m then return false end
        stopPlay()
        Play.t, Play.dur, Play.name = 0, m.dur, name
        local idx, eidx = 1, 1
        Play.conn = RunService.Heartbeat:Connect(function(dt)
            if not ENV.ZENOX_LOADED then stopPlay() return end
            local root, hum = getRoot(), getHum()
            if not root then return end

            Play.t += dt * M.speed
            if Play.t >= m.dur then
                if M.loop then
                    Play.t, idx, eidx = 0, 1, 1
                else
                    stopPlay()
                    if Cfg.macroPlay then flip("macroPlay") end
                    notify("Macro", "เล่นจบแล้ว", "check")
                    return
                end
            end

            local path, t = m.path, Play.t
            while idx < #path and path[idx + 1][1] <= t do idx += 1 end
            local a, b = path[idx], path[idx + 1] or path[idx]
            local alpha = (b[1] > a[1]) and math.clamp((t - a[1]) / (b[1] - a[1]), 0, 1) or 0
            local pos = Vector3.new(
                a[2] + (b[2] - a[2]) * alpha,
                a[3] + (b[3] - a[3]) * alpha,
                a[4] + (b[4] - a[4]) * alpha)
            local d = (b[5] - a[5] + math.pi) % (math.pi * 2) - math.pi
            root.CFrame = CFrame.new(pos) * CFrame.Angles(0, a[5] + d * alpha, 0)
            root.AssemblyLinearVelocity = Vector3.zero

            while m.events[eidx] and m.events[eidx][1] <= t do
                local e = m.events[eidx]
                if e[2] == "j" and hum then
                    hum:ChangeState(Enum.HumanoidStateType.Jumping)
                elseif e[2] == "k" and e[3] then
                    task.spawn(pressKeyName, e[3])
                end
                eidx += 1
            end
        end)
        return true
    end

