RunService.RenderStepped:Connect(function()
    local c = cam()
    local myRoot = getRoot()
    local rainbow = Color3.fromHSV((tick() % 5) / 5, 1, 1)
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            makeESP(plr)
            local o = espObjs[plr]
            local char = plr.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local root = char and char:FindFirstChild("HumanoidRootPart")
            local head = char and char:FindFirstChild("Head")
            local show = ESP.on and hum and root and head and hum.Health > 0
            local d = (myRoot and root) and (myRoot.Position - root.Position).Magnitude or 0
            if show and ESP.teamCheck and plr.Team ~= nil and plr.Team == LocalPlayer.Team then show = false end
            if show and d > ESP.maxDist then show = false end

            if show then
                local col = ESP.color
                if ESP.teamColor and plr.Team then col = plr.TeamColor.Color end
                if ESP.rainbow then col = rainbow end

                o.hl.Adornee = char
                o.hl.FillColor = col
                o.hl.OutlineColor = col
                o.hl.FillTransparency = ESP.fill
                o.hl.Enabled = true
                o.bb.Adornee = head
                o.bb.Enabled = true

                local parts = {}
                if ESP.name then table.insert(parts, plr.DisplayName) end
                if ESP.dist and myRoot then table.insert(parts, string.format("[%dm]", d)) end
                if ESP.health then table.insert(parts, string.format("HP %d", hum.Health)) end
                if ESP.tool then
                    local tool = char:FindFirstChildOfClass("Tool")
                    if tool then table.insert(parts, "<" .. tool.Name .. ">") end
                end
                o.txt.Text = table.concat(parts, " ")
                o.txt.TextColor3 = col

                local v, onScreen = c:WorldToViewportPoint(root.Position)
                if o.line then
                    if ESP.tracer and onScreen then
                        local vp = c.ViewportSize
                        o.line.From = Vector2.new(vp.X / 2, vp.Y)
                        o.line.To = Vector2.new(v.X, v.Y)
                        o.line.Color = col
                        o.line.Visible = true
                    else
                        o.line.Visible = false
                    end
                end
                if o.box then
                    if ESP.box then
                        local top, on1 = c:WorldToViewportPoint(head.Position + Vector3.new(0, 0.7, 0))
                        local bot, on2 = c:WorldToViewportPoint(root.Position - Vector3.new(0, 3, 0))
                        if on1 and on2 then
                            local h = math.abs(bot.Y - top.Y)
                            local w = h * 0.55
                            o.box.Size = Vector2.new(w, h)
                            o.box.Position = Vector2.new(top.X - w / 2, top.Y)
                            o.box.Color = col
                            o.box.Visible = true
                        else
                            o.box.Visible = false
                        end
                    else
                        o.box.Visible = false
                    end
                end
            else
                o.hl.Enabled = false
                o.hl.Adornee = nil
                o.bb.Enabled = false
                if o.line then o.line.Visible = false end
                if o.box then o.box.Visible = false end
            end
        end
    end
end)

