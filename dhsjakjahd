-- FREECAM
----------------------------------------------------------------
local Free = {on = false, speed = 3, pos = Vector3.zero, pitch = 0, yaw = 0, conn = nil, anch = false}

local function stopFree()
    if not Free.on then return end
    Free.on = false
    if Free.conn then Free.conn:Disconnect() Free.conn = nil end
    local c = cam()
    c.CameraType = Enum.CameraType.Custom
    local hum = getHum()
    if hum then c.CameraSubject = hum end
    local root = getRoot()
    if root then root.Anchored = Free.anch end
end

local function startFree()
    stopFree()
    local c = cam()
    Free.on = true
    Free.pos = c.CFrame.Position
    local x, y = c.CFrame:ToOrientation()
    Free.pitch, Free.yaw = x, y
    local root = getRoot()
    if root then Free.anch = root.Anchored root.Anchored = true end
    c.CameraType = Enum.CameraType.Scriptable
    Free.conn = RunService.RenderStepped:Connect(function(dt)
        local cm = cam()
        local rot = CFrame.fromOrientation(Free.pitch, Free.yaw, 0)
        local mv = Vector3.zero
        if UIS:IsKeyDown(Enum.KeyCode.W) then mv += Vector3.new(0, 0, -1) end
        if UIS:IsKeyDown(Enum.KeyCode.S) then mv += Vector3.new(0, 0, 1) end
        if UIS:IsKeyDown(Enum.KeyCode.A) then mv += Vector3.new(-1, 0, 0) end
        if UIS:IsKeyDown(Enum.KeyCode.D) then mv += Vector3.new(1, 0, 0) end
        if UIS:IsKeyDown(Enum.KeyCode.E) or flyUp then mv += Vector3.new(0, 1, 0) end
        if UIS:IsKeyDown(Enum.KeyCode.Q) or flyDown then mv += Vector3.new(0, -1, 0) end
        local hum = getHum()
        if hum and hum.MoveDirection.Magnitude > 0 then
            local r = cm.CFrame:VectorToObjectSpace(hum.MoveDirection)
            mv += Vector3.new(r.X, 0, r.Z)
        end
        Free.pos += rot:VectorToWorldSpace(mv) * Free.speed * 20 * dt
        cm.CFrame = CFrame.new(Free.pos) * rot
    end)
end

UIS.InputChanged:Connect(function(input, gp)
    if not Free.on then return end
    local t = input.UserInputType
    if (t == Enum.UserInputType.MouseMovement and UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2))
        or (t == Enum.UserInputType.Touch and not gp) then
        Free.yaw -= input.Delta.X * 0.004
        Free.pitch = math.clamp(Free.pitch - input.Delta.Y * 0.004, -1.5, 1.5)
    end
end)

