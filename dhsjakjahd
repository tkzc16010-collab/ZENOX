-- (ตั้ง ZENOX_LOADED = nil ทำให้ลูป Troll / Macro / Quick หยุดและเคลียร์ตัวเอง)
ENV.ZENOX_UNLOAD = function()
    ENV.ZENOX_LOADED = nil
    for k in pairs(S) do if type(S[k]) == "boolean" then S[k] = false end end
    Fly.on = false
    pcall(stopFly)
    pcall(stopFree)
    pcall(stopSpectate)
    pcall(stopFloat)
    AP.on = false
    ESP.on = false
    for plr in pairs(espObjs) do pcall(removeESP, plr) end
    pcall(function() espFolder:Destroy() end)
    pcall(function() HUD:Destroy() end)
    for _, e in ipairs({fxCC, fxNV, fxBloom, fxBlur, fxRays}) do pcall(function() e:Destroy() end) end
    pcall(setXray, false)
    local h = getHum()
    if h then h.WalkSpeed = Default.walk h.JumpPower = Default.jump h.HipHeight = 0 end
    local r = getRoot()
    if r then r.Anchored = false end
    workspace.Gravity = Default.gravity
    Lighting.Brightness = origLight.Brightness
    Lighting.GlobalShadows = origLight.GlobalShadows
    Lighting.Ambient = origLight.Ambient
    Lighting.OutdoorAmbient = origLight.OutdoorAmbient
    Lighting.FogEnd = origLight.FogEnd
    Lighting.FogStart = origLight.FogStart
    pcall(function() Window:Destroy() end)
end

