RunService.RenderStepped:Connect(function()
    if not Fly.on or not Fly.bv then return end
    local root, hum = getRoot(), getHum()
    if not root or not hum then return end
    local c = cam()
    local rel = c.CFrame:VectorToObjectSpace(hum.MoveDirection)
    local dir = c.CFrame.LookVector * (-rel.Z) + c.CFrame.RightVector * rel.X
    local up = 0
    if UIS:IsKeyDown(Enum.KeyCode.Space) or UIS:IsKeyDown(Enum.KeyCode.E) or flyUp then up += 1 end
    if UIS:IsKeyDown(Enum.KeyCode.LeftControl) or UIS:IsKeyDown(Enum.KeyCode.Q) or flyDown then up -= 1 end
    Fly.bv.Velocity = (dir + Vector3.new(0, up, 0)) * Fly.speed
    Fly.bg.CFrame = c.CFrame
end)

