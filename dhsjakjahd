local WindUI

local function runLoader(steps)
    local vp = cam() and cam().ViewportSize or Vector2.new(1280, 720)
    local OVER = 160 -- oversize so no edge/notch is ever visible
    local t0 = os.clock()

    -- hide default CoreGui bits while loading
    local prevCore = {}
    pcall(function()
        for _, t in ipairs({
            Enum.CoreGuiType.Chat, Enum.CoreGuiType.Backpack, Enum.CoreGuiType.PlayerList,
            Enum.CoreGuiType.EmotesMenu, Enum.CoreGuiType.Health,
        }) do
            prevCore[t] = StarterGui:GetCoreGuiEnabled(t)
            StarterGui:SetCoreGuiEnabled(t, false)
        end
    end)

    local gui = Instance.new("ScreenGui")
    gui.Name = "ZenoxLoader"
    gui.IgnoreGuiInset = true
    gui.ResetOnSpawn = false
    gui.DisplayOrder = 999
    pcall(function() gui.ScreenInsets = Enum.ScreenInsets.None end)
    pcall(function() gui.SafeAreaCompatibility = Enum.SafeAreaCompatibility.None end)
    gui.Parent = getGui()

    local root = Instance.new("CanvasGroup")
    root.AnchorPoint = Vector2.new(0.5, 0.5)
    root.Position = UDim2.fromScale(0.5, 0.5)
    root.Size = UDim2.new(1, OVER * 2, 1, OVER * 2)
    root.BackgroundColor3 = Color3.fromRGB(2, 6, 2)
    root.BorderSizePixel = 0
    root.GroupTransparency = 1
    root.Parent = gui

    TweenService:Create(root, TweenInfo.new(0.4), {GroupTransparency = 0}):Play()

    local W, H = vp.X + OVER * 2, vp.Y + OVER * 2

    -- Matrix rain
    local rows, colW = 26, 18
    local chars = "01ABCDEFGHIJKLMNOPQRSTUVWXYZ$#@%&*+=<>/\\|"
    local function randText()
        local t = {}
        for i = 1, rows do
            local r = math.random(1, #chars)
            t[i] = chars:sub(r, r)
        end
        return table.concat(t, "\n")
    end

    local cols = {}
    for i = 0, math.floor(W / colW) do
        local l = Instance.new("TextLabel")
        l.BackgroundTransparency = 1
        l.Size = UDim2.fromOffset(colW, rows * 15)
        l.Font = Enum.Font.Code
        l.TextSize = 14
        l.TextColor3 = GREEN
        l.TextTransparency = 0.55 + math.random() * 0.35
        l.Text = randText()
        l.ZIndex = 1
        l.Parent = root
        cols[i + 1] = {label = l, x = i * colW, y = -math.random(0, H), speed = math.random(70, 220)}
    end

    -- scan line
    local scan = Instance.new("Frame")
    scan.Size = UDim2.new(1, 0, 0, 90)
    scan.BackgroundColor3 = GREEN
    scan.BorderSizePixel = 0
    scan.ZIndex = 3
    scan.Parent = root
    local sg = Instance.new("UIGradient", scan)
    sg.Rotation = 90
    sg.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 1),
        NumberSequenceKeypoint.new(0.5, 0.88),
        NumberSequenceKeypoint.new(1, 1),
    })

    ------------------------------------------------------------
    -- Corner brackets + corner readouts (zoom in from screen edge)
    ------------------------------------------------------------
    local frameC = Instance.new("Frame")
    frameC.AnchorPoint = Vector2.new(0.5, 0.5)
    frameC.Position = UDim2.fromScale(0.5, 0.5)
    frameC.Size = UDim2.new(1, -(OVER * 2 + 2), 1, -(OVER * 2 + 2))
    frameC.BackgroundTransparency = 1
    frameC.ZIndex = 4
    frameC.Parent = root
    TweenService:Create(frameC, TweenInfo.new(1.1, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
        {Size = UDim2.new(1, -(OVER * 2 + 46), 1, -(OVER * 2 + 46))}):Play()

    local brackets = {}
    local function corner(ax, ay)
        for i = 1, 2 do
            local f = Instance.new("Frame")
            f.Size = (i == 1) and UDim2.fromOffset(40, 3) or UDim2.fromOffset(3, 40)
            f.AnchorPoint = Vector2.new(ax, ay)
            f.Position = UDim2.fromScale(ax, ay)
            f.BackgroundColor3 = GREEN
            f.BorderSizePixel = 0
            f.ZIndex = 4
            f.Parent = frameC
            table.insert(brackets, f)
        end
    end
    corner(0, 0) corner(1, 0) corner(0, 1) corner(1, 1)

    local function cornerText(ax, ay, px, py, align)
        local l = Instance.new("TextLabel")
        l.BackgroundTransparency = 1
        l.AnchorPoint = Vector2.new(ax, ay)
        l.Position = UDim2.new(ax, px, ay, py)
        l.Size = UDim2.fromOffset(260, 16)
        l.Font = Enum.Font.Code
        l.TextSize = 12
        l.TextColor3 = GREEN
        l.TextTransparency = 0.25
        l.TextXAlignment = align
        l.ZIndex = 4
        l.Text = ""
        l.Parent = frameC
        return l
    end
    local tl = cornerText(0, 0, 14, 12, Enum.TextXAlignment.Left)
    local tr = cornerText(1, 0, -14, 12, Enum.TextXAlignment.Right)
    local bl = cornerText(0, 1, 14, -12, Enum.TextXAlignment.Left)
    local br = cornerText(1, 1, -14, -12, Enum.TextXAlignment.Right)
    tl.Text = "ZENOX//SYS.BOOT"
    bl.Text = string.format("SID 0x%04X%04X", math.random(0, 0xFFFF), math.random(0, 0xFFFF))

    ------------------------------------------------------------
    -- Center panel
    ------------------------------------------------------------
    local panel = Instance.new("Frame")
    panel.AnchorPoint = Vector2.new(0.5, 0.5)
    panel.Position = UDim2.fromScale(0.5, 0.5)
    panel.Size = UDim2.fromOffset(460, 320)
    panel.BackgroundColor3 = Color3.fromRGB(3, 10, 3)
    panel.BackgroundTransparency = 0.15
    panel.BorderSizePixel = 0
    panel.ZIndex = 5
    panel.Parent = root
    Instance.new("UICorner", panel).CornerRadius = UDim.new(0, 10)
    local pStroke = Instance.new("UIStroke", panel)
    pStroke.Color = GREEN
    pStroke.Thickness = 1.5
    pStroke.Transparency = 0.2

    local alive = true
    task.spawn(function()
        while alive do
            TweenService:Create(pStroke, TweenInfo.new(0.9, Enum.EasingStyle.Sine), {Transparency = 0.7}):Play()
            task.wait(0.9)
            TweenService:Create(pStroke, TweenInfo.new(0.9, Enum.EasingStyle.Sine), {Transparency = 0.1}):Play()
            task.wait(0.9)
        end
    end)

    local TITLE = "ZENOX HUB"

    local ghost = Instance.new("TextLabel")
    ghost.BackgroundTransparency = 1
    ghost.AnchorPoint = Vector2.new(0.5, 0)
    ghost.Position = UDim2.new(0.5, 0, 0, 20)
    ghost.Size = UDim2.new(1, 0, 0, 56)
    ghost.Font = Enum.Font.Code
    ghost.TextSize = 46
    ghost.Text = TITLE
    ghost.TextColor3 = Color3.fromRGB(0, 255, 200)
    ghost.TextTransparency = 0.6
    ghost.ZIndex = 6
    ghost.Parent = panel

    local title = ghost:Clone()
    title.TextColor3 = GREEN
    title.TextTransparency = 0
    title.ZIndex = 7
    title.MaxVisibleGraphemes = 0
    title.Parent = panel
    local tStroke = Instance.new("UIStroke", title)
    tStroke.Color = DARK_GREEN
    tStroke.Thickness = 1

    local sub = Instance.new("TextLabel")
    sub.BackgroundTransparency = 1
    sub.AnchorPoint = Vector2.new(0.5, 0)
    sub.Position = UDim2.new(0.5, 0, 0, 78)
    sub.Size = UDim2.new(1, 0, 0, 22)
    sub.Font = Enum.Font.Code
    sub.TextSize = 16
    sub.Text = "B Y   T O N   |   v 3"
    sub.TextColor3 = Color3.fromRGB(150, 255, 170)
    sub.TextTransparency = 1
    sub.ZIndex = 7
    sub.Parent = panel

    local status = Instance.new("TextLabel")
    status.BackgroundTransparency = 1
    status.Position = UDim2.new(0, 20, 0, 116)
    status.Size = UDim2.new(1, -30, 0, 20)
    status.Font = Enum.Font.Code
    status.TextSize = 14
    status.Text = "> booting..."
    status.TextColor3 = GREEN
    status.TextXAlignment = Enum.TextXAlignment.Left
    status.ZIndex = 7
    status.Parent = panel

    local barBg = Instance.new("Frame")
    barBg.AnchorPoint = Vector2.new(0.5, 0)
    barBg.Position = UDim2.new(0.5, 0, 0, 146)
    barBg.Size = UDim2.new(1, -40, 0, 8)
    barBg.BackgroundColor3 = Color3.fromRGB(10, 30, 10)
    barBg.BorderSizePixel = 0
    barBg.ZIndex = 7
    barBg.Parent = panel
    Instance.new("UICorner", barBg).CornerRadius = UDim.new(1, 0)
    local bStroke = Instance.new("UIStroke", barBg)
    bStroke.Color = DARK_GREEN
    bStroke.Thickness = 1

    local fill = Instance.new("Frame")
    fill.Size = UDim2.fromScale(0, 1)
    fill.BackgroundColor3 = GREEN
    fill.BorderSizePixel = 0
    fill.ZIndex = 8
    fill.Parent = barBg
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)
    local grad = Instance.new("UIGradient", fill)
    grad.Color = ColorSequence.new(DARK_GREEN, Color3.fromRGB(150, 255, 150))

    local pct = Instance.new("TextLabel")
    pct.BackgroundTransparency = 1
    pct.AnchorPoint = Vector2.new(1, 0)
    pct.Position = UDim2.new(1, -20, 0, 160)
    pct.Size = UDim2.fromOffset(90, 20)
    pct.Font = Enum.Font.Code
    pct.TextSize = 14
    pct.Text = "000%"
    pct.TextColor3 = GREEN
    pct.TextXAlignment = Enum.TextXAlignment.Right
    pct.ZIndex = 7
    pct.Parent = panel

    local hexNum = Instance.new("TextLabel")
    hexNum.BackgroundTransparency = 1
    hexNum.Position = UDim2.new(0, 20, 0, 160)
    hexNum.Size = UDim2.fromOffset(200, 20)
    hexNum.Font = Enum.Font.Code
    hexNum.TextSize = 12
    hexNum.Text = "0x00000000"
    hexNum.TextColor3 = Color3.fromRGB(0, 200, 120)
    hexNum.TextTransparency = 0.2
    hexNum.TextXAlignment = Enum.TextXAlignment.Left
    hexNum.ZIndex = 7
    hexNum.Parent = panel

    -- terminal log
    local sep = Instance.new("Frame")
    sep.Position = UDim2.new(0, 20, 0, 190)
    sep.Size = UDim2.new(1, -40, 0, 1)
    sep.BackgroundColor3 = DARK_GREEN
    sep.BorderSizePixel = 0
    sep.ZIndex = 7
    sep.Parent = panel

    local logLabel = Instance.new("TextLabel")
    logLabel.BackgroundTransparency = 1
    logLabel.Position = UDim2.new(0, 20, 0, 198)
    logLabel.Size = UDim2.new(1, -40, 0, 108)
    logLabel.Font = Enum.Font.Code
    logLabel.TextSize = 12
    logLabel.RichText = true
    logLabel.TextColor3 = Color3.fromRGB(120, 200, 140)
    logLabel.TextXAlignment = Enum.TextXAlignment.Left
    logLabel.TextYAlignment = Enum.TextYAlignment.Bottom
    logLabel.Text = ""
    logLabel.ZIndex = 7
    logLabel.Parent = panel

    local logLines = {}
    local tagColor = {ok = "#00ff41", info = "#00e5ff", run = "#8aa88a", fail = "#ff4d4d"}
    local tagText = {ok = "[ OK ]", info = "[INFO]", run = "[ .. ]", fail = "[FAIL]"}
    local function addLog(kind, text)
        text = tostring(text):gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;")
        table.insert(logLines, string.format('<font color="%s">%s</font> %s', tagColor[kind], tagText[kind], text))
        while #logLines > 7 do table.remove(logLines, 1) end
        logLabel.Text = table.concat(logLines, "\n")
    end

    ------------------------------------------------------------
    -- Animation loops
    ------------------------------------------------------------
    local statusText = "booting..."
    local spin = {"|", "/", "-", "\\"}
    local spinIdx, pkt, acc, tickAcc = 1, math.random(1000, 9000), 0, 0
    local target, shown = 0, 0

    local rainConn = RunService.RenderStepped:Connect(function(dt)
        acc += dt
        tickAcc += dt
        for _, c in ipairs(cols) do
            c.y += c.speed * dt
            if c.y > H then c.y = -rows * 15 end
            c.label.Position = UDim2.fromOffset(c.x, c.y)
        end
        scan.Position = UDim2.fromOffset(0, ((os.clock() * 260) % (H + 180)) - 90)
        if acc > 0.12 then
            acc = 0
            for _ = 1, 6 do
                local c = cols[math.random(1, #cols)]
                if c then c.label.Text = randText() end
            end
        end

        -- bracket pulse
        local a = 0.1 + 0.4 * ((math.sin(os.clock() * 3) + 1) / 2)
        for _, f in ipairs(brackets) do f.BackgroundTransparency = a end

        -- running numbers
        if tickAcc > 0.06 then
            tickAcc = 0
            pkt += math.random(1, 9)
            tr.Text = string.format("%s   T+%05.2f", os.date("%H:%M:%S"), os.clock() - t0)
            br.Text = string.format("PKT %06d   MEM 0x%04X%04X", pkt, math.random(0, 0xFFFF), math.random(0, 0xFFFF))
            hexNum.Text = string.format("0x%04X%04X", math.random(0, 0xFFFF), math.random(0, 0xFFFF))
            spinIdx = spinIdx % 4 + 1
            status.Text = "> " .. statusText .. " " .. spin[spinIdx]
        end

        shown += (target - shown) * math.min(1, dt * 5)
        fill.Size = UDim2.fromScale(math.clamp(shown / 100, 0, 1), 1)
        pct.Text = string.format("%03d%%", math.floor(shown + 0.5))
        grad.Offset = Vector2.new(math.sin(os.clock() * 2) * 0.2, 0)
    end)

    task.spawn(function()
        while alive do
            task.wait(0.8 + math.random() * 0.8)
            for _ = 1, 4 do
                if not alive then break end
                ghost.Position = UDim2.new(0.5, math.random(-6, 6), 0, 20 + math.random(-2, 2))
                title.TextColor3 = math.random() > 0.5 and Color3.fromRGB(180, 255, 190) or GREEN
                task.wait(0.04)
            end
            ghost.Position = UDim2.new(0.5, 0, 0, 20)
            title.TextColor3 = GREEN
        end
    end)

    -- typewriter title
    for i = 1, #TITLE do
        title.MaxVisibleGraphemes = i
        task.wait(0.07)
    end
    TweenService:Create(sub, TweenInfo.new(0.6), {TextTransparency = 0}):Play()

    -- system info lines
    local exec = "unknown"
    pcall(function() exec = identifyexecutor() end)
    addLog("info", "user: " .. LocalPlayer.Name)
    task.wait(0.15)
    addLog("info", "place: " .. tostring(game.PlaceId))
    task.wait(0.15)
    addLog("info", "executor: " .. tostring(exec))
    task.wait(0.15)

    -- run steps
    for _, s in ipairs(steps) do
        statusText = s.text
        addLog("run", s.text)
        target = s.pct
        local ok = true
        if s.fn then
            local success, err = pcall(s.fn)
            if not success then
                ok = false
                warn("[ZENOX] step error:", err)
            end
        end
        task.wait(s.wait or 0.4)
        addLog(ok and "ok" or "fail", s.text)
    end

    target = 100
    statusText = "ACCESS GRANTED"
    addLog("ok", "all modules online")
    task.wait(0.8)

    alive = false
    TweenService:Create(root, TweenInfo.new(0.7, Enum.EasingStyle.Quad), {GroupTransparency = 1}):Play()
    task.wait(0.75)
    rainConn:Disconnect()
    gui:Destroy()

    pcall(function()
        for t, v in pairs(prevCore) do StarterGui:SetCoreGuiEnabled(t, v) end
    end)
end

