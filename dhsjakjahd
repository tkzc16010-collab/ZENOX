local VIM
pcall(function() VIM = game:GetService("VirtualInputManager") end)

local AP = {on = false, interval = 0.5, hold = 0.05, key = "E"}
local APList = {"E", "F", "R", "Q", "Z", "X", "C", "V", "G", "T", "Space", "1", "2", "3", "4", "5", "Mouse Click"}
local APMap = {
    E = {Enum.KeyCode.E, 0x45}, F = {Enum.KeyCode.F, 0x46}, R = {Enum.KeyCode.R, 0x52},
    Q = {Enum.KeyCode.Q, 0x51}, Z = {Enum.KeyCode.Z, 0x5A}, X = {Enum.KeyCode.X, 0x58},
    C = {Enum.KeyCode.C, 0x43}, V = {Enum.KeyCode.V, 0x56}, G = {Enum.KeyCode.G, 0x47},
    T = {Enum.KeyCode.T, 0x54}, Space = {Enum.KeyCode.Space, 0x20},
    ["1"] = {Enum.KeyCode.One, 0x31}, ["2"] = {Enum.KeyCode.Two, 0x32},
    ["3"] = {Enum.KeyCode.Three, 0x33}, ["4"] = {Enum.KeyCode.Four, 0x34},
    ["5"] = {Enum.KeyCode.Five, 0x35},
}

local function autoPressOnce()
    if AP.key == "Mouse Click" then
        local ok = false
        if VIM then
            ok = pcall(function()
                local v = cam().ViewportSize
                VIM:SendMouseButtonEvent(v.X / 2, v.Y / 2, 0, true, game, 0)
                task.wait(0.02)
                VIM:SendMouseButtonEvent(v.X / 2, v.Y / 2, 0, false, game, 0)
            end)
        end
        if not ok and typeof(mouse1click) == "function" then pcall(mouse1click) end
        return
    end
    local e = APMap[AP.key]
    if not e then return end
    local ok = false
    if VIM then
        ok = pcall(function()
            VIM:SendKeyEvent(true, e[1], false, game)
            task.wait(AP.hold)
            VIM:SendKeyEvent(false, e[1], false, game)
        end)
    end
    if not ok and typeof(keypress) == "function" and typeof(keyrelease) == "function" then
        pcall(function()
            keypress(e[2])
            task.wait(AP.hold)
            keyrelease(e[2])
        end)
    end
end

task.spawn(function()
    while true do
        task.wait(math.max(0.03, AP.interval))
        if AP.on then autoPressOnce() end
    end
end)

