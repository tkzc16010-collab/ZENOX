local xrayParts = {}
local function setXray(state)
    if state then
        for _, p in ipairs(workspace:GetDescendants()) do
            if p:IsA("BasePart") and not p:IsDescendantOf(LocalPlayer.Character or workspace) then
                local m = p:FindFirstAncestorOfClass("Model")
                if not (m and Players:GetPlayerFromCharacter(m)) and p.Transparency < 0.6 then
                    xrayParts[p] = true
                    p.LocalTransparencyModifier = 0.6
                end
            end
        end
    else
        for p in pairs(xrayParts) do
            if p and p.Parent then p.LocalTransparencyModifier = 0 end
        end
        xrayParts = {}
    end
end

