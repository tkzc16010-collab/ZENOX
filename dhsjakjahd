local function getGui()
    local ok, g = pcall(function()
        return (gethui and gethui()) or game:GetService("CoreGui")
    end)
    if ok and g then return g end
    return LocalPlayer:WaitForChild("PlayerGui")
end

local function getChar() return LocalPlayer.Character end
local function getHum()
    local c = getChar()
    return c and c:FindFirstChildOfClass("Humanoid")
end
local function getRoot()
    local c = getChar()
    return c and c:FindFirstChild("HumanoidRootPart")
end
local function cam() return workspace.CurrentCamera end

----------------------------------------------------------------
-- Config storage
----------------------------------------------------------------
local CFG_DIR  = "ZenoxHub"
local CFG_FILE = "ZenoxHub/config.json"
local canFile  = (writefile and readfile and isfile) and true or false
local Store = {settings = {}, waypoints = {}, autoload = false, theme = "Hacker Green"}

local function loadStore()
    if not canFile then return end
    pcall(function()
        if isfile(CFG_FILE) then
            local d = HttpService:JSONDecode(readfile(CFG_FILE))
            if type(d) == "table" then
                for k, v in pairs(d) do Store[k] = v end
            end
        end
    end)
end

local function saveStore()
    if not canFile then return false end
    local ok = pcall(function()
        if makefolder and isfolder and not isfolder(CFG_DIR) then makefolder(CFG_DIR) end
        writefile(CFG_FILE, HttpService:JSONEncode(Store))
    end)
    return ok
end

